{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horus:query-response:1.3.0",
  "title": "Horus Query Response",
  "description": "Provenance-bearing Horus response with explicit source states and a deterministic acquisition receipt. A search gap is not valid unless the search procedure itself is recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "query_id", "requesting_minister", "request_as_received", "status", "source_absence_taxonomy", "acquisition", "sources_searched", "sources_used", "sources_rejected", "records_returned", "unfilled_requests", "provenance", "completeness"],
  "properties": {
    "record_type": {"const": "horus_query_response"},
    "query_id": {"type": "string", "pattern": "^(MHQ|MHAQ)-[A-Z0-9_-]+$"},
    "requesting_minister": {"type": "string", "minLength": 1},
    "request_as_received": {"type": "object"},
    "status": {"enum": ["GATHERED", "PARTIALLY_GATHERED", "NOT_GATHERED"]},
    "source_absence_taxonomy": {"const": "HORUS-SOURCE-STATE-1.0"},
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "plan_sha256", "principal_profiles", "date_normalizations", "search_attempts", "requirements", "runtime"],
      "properties": {
        "protocol": {"const": "HORUS-ACQUISITION-1.0"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "principal_profiles": {"type": "array", "items": {"type": "object"}},
        "date_normalizations": {"type": "array", "items": {"type": "object"}},
        "search_attempts": {"type": "array", "items": {"type": "object"}},
        "requirements": {"type": "array", "items": {"type": "object"}},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "engine_path", "mode"],
          "properties": {
            "engine": {"const": "HORUS_CANONICAL_ACQUISITION_ENGINE"},
            "engine_path": {"const": "runtime/gather.py"},
            "mode": {"enum": ["LIVE", "FIXTURE"]}
          }
        }
      }
    },
    "sources_searched": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "sources_used": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "sources_rejected": {"type": "array", "items": {"$ref": "#/$defs/rejected_source_record"}},
    "records_returned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["information_need", "finding", "evidence_state", "source_refs"],
        "properties": {
          "information_need": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["SUPPORTED", "CONTRADICTORY_RECORD", "DOCUMENTED_ABSENCE"]},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "absence_scope": {"type": ["string", "null"]},
          "absence_basis": {"type": ["string", "null"]},
          "tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
          "language": {"type": ["string", "null"]},
          "language_state": {"enum": ["ORIGINAL", "TRANSLATION_ONLY", "NONE", "NOT_APPLICABLE"]}
        },
        "allOf": [{
          "if": {"properties": {"evidence_state": {"const": "DOCUMENTED_ABSENCE"}}, "required": ["evidence_state"]},
          "then": {
            "required": ["absence_scope", "absence_basis"],
            "properties": {
              "absence_scope": {"type": "string", "minLength": 1},
              "absence_basis": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "absence_scope": {"type": "null"},
              "absence_basis": {"type": "null"}
            }
          }
        }]
      }
    },
    "unfilled_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["information_need", "reason", "evidence_state", "searched_source_refs", "searched_attempt_refs", "absence_claim"],
        "properties": {
          "information_need": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["NOT_SEARCHED", "SEARCHED_NOT_FOUND", "SOURCE_EXISTS_NOT_ACQUIRED", "SOURCE_ACQUIRED_INCOMPLETE"]},
          "searched_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "searched_attempt_refs": {"type": "array", "items": {"type": "string", "pattern": "^ATT-[A-Z0-9_-]+$"}},
          "absence_claim": {"const": false}
        },
        "allOf": [{
          "if": {"properties": {"evidence_state": {"const": "NOT_SEARCHED"}}, "required": ["evidence_state"]},
          "then": {
            "properties": {
              "searched_source_refs": {"maxItems": 0},
              "searched_attempt_refs": {"maxItems": 0}
            }
          },
          "else": {"properties": {"searched_attempt_refs": {"minItems": 1}}}
        }]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horus_repository_commit", "generated_at"],
      "properties": {
        "horus_repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "query_log_path": {"type": "string", "minLength": 1}
      }
    },
    "completeness": {"const": "PENDING_PROBE"}
  },
  "$defs": {
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "document_identity", "issuer", "date", "source_tier", "retrieval_date"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "document_identity": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "issuer": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "source_tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
        "retrieval_date": {"type": "string", "format": "date"},
        "repository_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "relevant_locator": {"type": ["string", "null"]}
      }
    },
    "rejected_source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "document_identity", "issuer", "date", "source_tier", "retrieval_date", "rejection_reason"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "document_identity": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "issuer": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "source_tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
        "retrieval_date": {"type": "string", "format": "date"},
        "repository_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "relevant_locator": {"type": ["string", "null"]},
        "rejection_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
