{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horus:query-response:1.2.0",
  "title": "Horus Query Response",
  "description": "Forward provenance-bearing Horus response with explicit epistemic source states. Missing ground is never silently converted into documented absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "query_id", "requesting_minister", "request_as_received", "status",
    "source_absence_taxonomy", "sources_searched", "sources_used", "sources_rejected",
    "records_returned", "unfilled_requests", "provenance", "completeness"
  ],
  "properties": {
    "record_type": {"const": "horus_query_response"},
    "query_id": {"type": "string", "pattern": "^(MHQ|MHAQ)-[A-Z0-9_-]+$"},
    "requesting_minister": {"type": "string", "minLength": 1},
    "request_as_received": {"type": "object"},
    "status": {"enum": ["GATHERED", "PARTIALLY_GATHERED", "NOT_GATHERED"]},
    "source_absence_taxonomy": {"const": "HORUS-SOURCE-STATE-1.0"},
    "sources_searched": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "sources_used": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "sources_rejected": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/source_record"},
          {"type": "object", "required": ["rejection_reason"], "properties": {"rejection_reason": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "records_returned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["information_need", "finding", "evidence_state", "source_refs"],
        "properties": {
          "information_need": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["SUPPORTED", "CONTRADICTORY_RECORD", "DOCUMENTED_ABSENCE"]},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "absence_scope": {"type": ["string", "null"]},
          "absence_basis": {"type": ["string", "null"]},
          "tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
          "language": {"type": ["string", "null"]},
          "language_state": {"enum": ["ORIGINAL", "TRANSLATION_ONLY", "NONE", "NOT_APPLICABLE"]}
        },
        "allOf": [{
          "if": {"properties": {"evidence_state": {"const": "DOCUMENTED_ABSENCE"}}},
          "then": {"required": ["absence_scope", "absence_basis"]},
          "else": {
            "properties": {
              "absence_scope": {"type": "null"},
              "absence_basis": {"type": "null"}
            }
          }
        }]
      }
    },
    "unfilled_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["information_need", "reason", "evidence_state", "searched_source_refs", "absence_claim"],
        "properties": {
          "information_need": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["NOT_SEARCHED", "SEARCHED_NOT_FOUND", "SOURCE_EXISTS_NOT_ACQUIRED", "SOURCE_ACQUIRED_INCOMPLETE"]},
          "searched_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "absence_claim": {"const": false}
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_state": {"const": "NOT_SEARCHED"}}},
            "then": {"properties": {"searched_source_refs": {"maxItems": 0}}},
            "else": {"properties": {"searched_source_refs": {"minItems": 1}}}
          }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horus_repository_commit", "generated_at"],
      "properties": {
        "horus_repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "query_log_path": {"type": "string", "minLength": 1}
      }
    },
    "completeness": {"const": "PENDING_PROBE"}
  },
  "$defs": {
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "document_identity", "issuer", "date", "source_tier", "retrieval_date"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "document_identity": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "issuer": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "source_tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
        "retrieval_date": {"type": "string", "format": "date"},
        "repository_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "relevant_locator": {"type": ["string", "null"]}
      }
    }
  }
}
