{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horus:query-response:1.1.0",
  "title": "Horus Query Response",
  "description": "Provenance-bearing response for both ordinary investigative MHQ requests and adversarial MHAQ requests. Horus gathers and does not judge whether adversarial evidence defeats a proposition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "query_id",
    "requesting_minister",
    "request_as_received",
    "status",
    "sources_searched",
    "sources_used",
    "sources_rejected",
    "records_returned",
    "unfilled_requests",
    "provenance",
    "completeness"
  ],
  "properties": {
    "record_type": {"const": "horus_query_response"},
    "query_id": {"type": "string", "pattern": "^(MHQ|MHAQ)-[A-Z0-9_-]+$"},
    "requesting_minister": {"type": "string", "minLength": 1},
    "request_as_received": {"type": "object"},
    "status": {"enum": ["GATHERED", "PARTIALLY_GATHERED", "NOT_GATHERED"]},
    "sources_searched": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "sources_used": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "sources_rejected": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/source_record"},
          {"type": "object", "required": ["rejection_reason"], "properties": {"rejection_reason": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "records_returned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["information_need", "finding", "source_refs"],
        "properties": {
          "information_need": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
          "language": {"type": ["string", "null"]},
          "language_state": {"enum": ["ORIGINAL", "TRANSLATION_ONLY", "NONE", "NOT_APPLICABLE"]}
        }
      }
    },
    "unfilled_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["information_need", "reason"],
        "properties": {
          "information_need": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "searched_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horus_repository_commit", "generated_at"],
      "properties": {
        "horus_repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "query_log_path": {"type": "string", "minLength": 1}
      }
    },
    "completeness": {"const": "PENDING_PROBE"}
  },
  "$defs": {
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "document_identity", "issuer", "date", "source_tier", "retrieval_date"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "document_identity": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "issuer": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "source_tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
        "retrieval_date": {"type": "string", "format": "date"},
        "repository_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "relevant_locator": {"type": ["string", "null"]}
      }
    }
  }
}
